// Live control posture pulled from Microsoft Defender via Graph Secure Score
// (secureScores.controlScores joined with secureScoreControlProfiles). One row
// per Microsoft control name per tenant, refreshed by POST /grc-defender/defender-sync.
model GrcDefenderControl {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @db.Uuid
  controlName          String
  title                String
  category             String
  service              String?
  actionType           String?
  maxScore             Decimal  @db.Decimal(8, 2)
  currentScore         Decimal  @db.Decimal(8, 2)
  implementationStatus String
  remediation          String?
  threats              String[]
  source               String   @default("defender") // defender | simulated
  lastSyncedAt         DateTime @db.Timestamptz

  @@unique([tenantId, controlName])
  @@index([tenantId, category])
  @@map("grc_defender_control")
}
